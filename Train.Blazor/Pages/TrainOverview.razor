@page "/trains"
@using System.Threading
@using Trains.DataAccess.Models

@inject ITrainService TrainService
@inject IDialogService DialogService
@inherits ReactiveComponentBase

<h3>TrainOverview</h3>

<MudStack>
	@if (trains is null) {
		<p><em>Loading...</em></p>
	} else {
		<MudGrid>
			@foreach (var train in trains) {
				<MudItem xs="4">
					<TrainInfo Train="train"></TrainInfo>
				</MudItem>
			}
		</MudGrid>
	}

	<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddTrain">Add</MudButton>
</MudStack>


@code {
	private List<Train>? trains;
	private ReactiveLoader? reactiveLoader;

	protected override void OnInitialized() {
		reactiveLoader = new(ParametersSet, Load);
	}

	private async Task Load(CancellationToken cancellationToken) {
		trains = await TrainService.ListTrains(cancellationToken);
		StateHasChanged();
	}

	private async Task AddTrain() {
		var newTrain = new Train() { Icon = "", Name = "" };
		var parameters = new DialogParameters<EditTrain> { { x => x.Train, newTrain } };

		var dialog = await DialogService.ShowAsync<EditTrain>("New train", parameters);
		var result = await dialog.GetReturnValueAsync<Train>();

		if (result is not null) {
			await TrainService.SaveTrain(result);
			trains?.Add(result);
		}
		StateHasChanged();
	}

	public override void Dispose() {
		reactiveLoader?.Dispose();
		base.Dispose();
	}
}
