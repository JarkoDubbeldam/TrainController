<MudCard Style="min-width: 300px">
    <MudCardHeader>
        <MudText Typo=Typo.h5>@Train.Name</MudText>
    </MudCardHeader>
    <MudCardMedia Image="@Train.Icon" Height="35" Style="background-position: 5em;" />
    <MudCardContent>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public required Train Train { get; set; }

    private string BackgroundUrl => $"background-image: url('{Train.Icon}');";
}
