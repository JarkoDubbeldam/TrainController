@using System.Net.Http.Json
@using System.Net.Http
@using System.Text.Json.Serialization
@using System.IO
@using System.Text.Json
@inject HttpClient HttpClient

<svg height=@Height width=@Width stroke="black" fill="transparent" stroke-width="5" stroke-opacity="60%">
	<CascadingValue Name=@nameof(GridScale) Value=@GridScale TValue="int">
		<g>
			@foreach (var item in _items) {
				if (item is Line line) {
					<LineSection X="line.X" Y="line.Y" Direction="line.Direction" Segments="line.Segments" />
				}
				if (item is End end) {
					<TrackEnd X="end.X" Y="end.Y" Orientation="end.Orientation" />
				}
				if (item is Signal signal) {
					<SignalGridItem X="signal.X" Y="signal.Y" Orientation="signal.Orientation" SignalId="signal.SignalId" />
				}
			}
		</g>
	</CascadingValue>
</svg>

@code {
	[Parameter]
	public int GridScale { get; set; }
	[Parameter]
	public int Height { get; set; }
	[Parameter]
	public int Width { get; set; }

	private List<GridElement> _items = [];

	protected override async Task OnInitializedAsync() {
		var json = await File.ReadAllTextAsync(Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "assets", "track-layout.json"));
		var items = JsonSerializer.Deserialize<List<GridElement>>(json, new JsonSerializerOptions {
				PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
				Converters = {
				new JsonStringEnumConverter()
			}
			});
		if (items != null) {
			_items = items;
		}
	}

	[JsonDerivedType(typeof(Line), "line")]
	[JsonDerivedType(typeof(End), "end")]
	[JsonDerivedType(typeof(Signal), "signal")]
	private class GridElement {
		public int X { get; set; }
		public int Y { get; set; }
	}

	private class Line : GridElement {
		public LineDirection Direction { get; set; }
		public List<int> Segments { get; set; } = [];
	}
	private class End : GridElement {
		public TrackEndOrientation Orientation { get; set; }
	}
	private class Signal : GridElement {
		public SignalOrientation Orientation { get; set; }
		public int SignalId { get; set; }
	}
}
