@using Trains.DataAccess.Models
@inject NavigationManager NavigationManager


<MudDialog>
	<DialogContent>
		<EditForm Model="@Train" OnValidSubmit="OnSave">
			<MudNumericField T=int Label="Id" Required=true @bind-Value="Train.Id" For="@(() => Train.Id)" />
			<MudTextField T=string Label="Name" Required=true @bind-Value="Train.Name" For="@(() => Train.Name)" />
			<MudRadioGroup @bind-Value=Train.Icon>
				@foreach (var image in TrainImages) {
					<MudRadio Color="Color.Primary" Value="@image">
						<MudImage Src=@image />
					</MudRadio>
				}
			</MudRadioGroup>
			<DataAnnotationsValidator/>
		</EditForm>
	</DialogContent>

	<DialogActions>
		<MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mr-auto" OnClick="OnCancel">Cancel</MudButton>
		<MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="OnSave">Save</MudButton>
	</DialogActions>
</MudDialog>

@code {
	private static readonly List<string> TrainImages = new()
											{
		"train-icons/DB 168.png",
		"train-icons/GTW.png",
		"train-icons/ICM.png",
		"train-icons/Mat54.png",
		"train-icons/NS 1600.png",
		"train-icons/NS 6400.png",
		"train-icons/Traxx.png",
		"train-icons/Wadloper.png",
	};

	[CascadingParameter]
	public required IMudDialogInstance MudDialog { get; set; }

	private void OnCancel() {
		MudDialog.Cancel();
	}

	private void OnSave() {
		MudDialog.Close(Train);
	}

	[Parameter]
	public required Train Train { get; set; }
}
